{
  "version": 8,
  "name": "UMaps Riyadh B — clean basemap (no labels, no POIs)",
  "sources": {
    "umaps": {
      "type": "vector",
      "tiles": ["obrpm://umaps-b/{z}/{x}/{y}"],
      "minzoom": 10,
      "maxzoom": 16,
      "bounds": [46.20, 24.30, 47.10, 25.05]
    }
  },
  "layers": [
    { "id": "country-fill", "type": "fill", "source": "umaps", "source-layer": "Country_Pol",
      "minzoom": 10, "maxzoom": 12,
      "paint": { "fill-color": "#e5ddcc", "fill-opacity": 0.9 } },
    { "id": "country-line", "type": "line", "source": "umaps", "source-layer": "Country_Pol",
      "minzoom": 10, "maxzoom": 12,
      "paint": { "line-color": "#b9a988", "line-width": 1.2 } },
    { "id": "region-line", "type": "line", "source": "umaps", "source-layer": "Region",
      "minzoom": 10, "maxzoom": 12,
      "paint": { "line-color": "#a89a80", "line-width": 1 } },
    { "id": "urban-fill", "type": "fill", "source": "umaps", "source-layer": "luUrbanAreaBoundaryS",
      "minzoom": 10,
      "paint": { "fill-color": "#e3dcc9", "fill-opacity": 0.5 } },
    { "id": "green-1", "type": "fill", "source": "umaps", "source-layer": "GreenArea_onlyKSA",
      "minzoom": 10,
      "paint": { "fill-color": "#bcd2a8", "fill-opacity": 0.7 } },
    { "id": "green-2", "type": "fill", "source": "umaps", "source-layer": "PlantedArea",
      "minzoom": 10,
      "paint": { "fill-color": "#bcd2a8", "fill-opacity": 0.7 } },
    { "id": "green-3", "type": "fill", "source": "umaps", "source-layer": "lcParkS",
      "minzoom": 10,
      "paint": { "fill-color": "#b8cfaa", "fill-opacity": 0.65 } },
    { "id": "parks", "type": "fill", "source": "umaps", "source-layer": "Parks and Sports area",
      "minzoom": 10,
      "paint": { "fill-color": "#b8cfaa", "fill-opacity": 0.65 } },
    { "id": "water-1", "type": "fill", "source": "umaps", "source-layer": "Lakes",
      "minzoom": 10,
      "paint": { "fill-color": "#a9c8d8", "fill-opacity": 0.9 } },
    { "id": "water-2", "type": "fill", "source": "umaps", "source-layer": "hyStreamAreaS",
      "minzoom": 10,
      "paint": { "fill-color": "#a9c8d8", "fill-opacity": 0.9 } },
    { "id": "water-3", "type": "fill", "source": "umaps", "source-layer": "WadiHanifa_Diss",
      "minzoom": 10,
      "paint": { "fill-color": "#a9c8d8", "fill-opacity": 0.9 } },
    { "id": "proj-qidiya", "type": "fill", "source": "umaps", "source-layer": "Qidiya",
      "minzoom": 10,
      "paint": { "fill-color": "#d9c49a", "fill-opacity": 0.25 } },
    { "id": "proj-mega", "type": "fill", "source": "umaps", "source-layer": "MegaProjectS",
      "minzoom": 10,
      "paint": { "fill-color": "#d9c49a", "fill-opacity": 0.25 } },
    { "id": "proj-reserved", "type": "fill", "source": "umaps", "source-layer": "ReservedAreaS:1",
      "minzoom": 10,
      "paint": { "fill-color": "#c8b0a0", "fill-opacity": 0.25 } },
    { "id": "res-com", "type": "fill", "source": "umaps", "source-layer": "ResidentialComercial",
      "minzoom": 11,
      "paint": { "fill-color": "#e8dcc4", "fill-opacity": 0.5 } },
    { "id": "dist-14k", "type": "line", "source": "umaps", "source-layer": "raDistrictS14k",
      "minzoom": 11, "paint": { "line-color": "#9a8a6e", "line-width": 1 } },
    { "id": "dist-18k", "type": "line", "source": "umaps", "source-layer": "raDistrictS18K",
      "minzoom": 11, "paint": { "line-color": "#9a8a6e", "line-width": 1 } },
    { "id": "dist-less18k", "type": "line", "source": "umaps", "source-layer": "raDistrictSLess18k",
      "minzoom": 11, "paint": { "line-color": "#9a8a6e", "line-width": 1 } },
    { "id": "rail", "type": "line", "source": "umaps", "source-layer": "Railway",
      "minzoom": 10,
      "paint": { "line-color": "#8a8a8a", "line-width": 1 } },
    { "id": "metro", "type": "line", "source": "umaps", "source-layer": "MetroLines",
      "minzoom": 10,
      "paint": { "line-color": "#7a9a7a", "line-width": 1.2 } },
    { "id": "roads-main", "type": "line", "source": "umaps", "source-layer": "All_StreetCenterLine",
      "minzoom": 10,
      "paint": { "line-color": "#d8b47a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.8, 14, 1.5, 16, 2.2] } },
    { "id": "roads-sec", "type": "line", "source": "umaps", "source-layer": "StreetCenterLine_Without_Tunnel",
      "minzoom": 12, "paint": { "line-color": "#ffffff", "line-width": 1.3 } },
    { "id": "roads-park", "type": "line", "source": "umaps", "source-layer": "StreetsInPark",
      "minzoom": 13, "paint": { "line-color": "#ffffff", "line-width": 1 } },
    { "id": "roads-bridge", "type": "line", "source": "umaps", "source-layer": "Road passes over a bridge",
      "minzoom": 12, "paint": { "line-color": "#e8c88a", "line-width": 1.5 } },
    { "id": "airport-runway", "type": "fill", "source": "umaps", "source-layer": "Airport_Runway_P",
      "minzoom": 12, "paint": { "fill-color": "#cfc8b8", "fill-opacity": 0.9 } },
    { "id": "airport-bld", "type": "fill", "source": "umaps", "source-layer": "BuildingAirport",
      "minzoom": 13, "paint": { "fill-color": "#cfc8b8", "fill-opacity": 0.9 } },
    { "id": "buildings", "type": "fill", "source": "umaps", "source-layer": "Building Footprints",
      "minzoom": 13,
      "paint": { "fill-color": "#d1c4b2", "fill-opacity": 0.75, "fill-outline-color": "#9c8c78" } },
    { "id": "parcels-fill", "type": "fill", "source": "umaps", "source-layer": "SubDivisionParcelBoundary",
      "minzoom": 13, "paint": { "fill-color": "#efe5d4", "fill-opacity": 0.12 } },
    { "id": "parcels-line", "type": "line", "source": "umaps", "source-layer": "SubDivisionParcelBoundary",
      "minzoom": 13,
      "paint": { "line-color": "#b56f22",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.6, 14, 1.2, 16, 2] } }
  ]
}
