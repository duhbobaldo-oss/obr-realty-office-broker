{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Realty Office",
  "version": "0.1.0",
  "identifier": "com.mawasib.obr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "مكتب الوسيط العقاري - OBR",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "generalAutofillEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "object-src": "'self' data:",
        "frame-src": "'self' blob: data:",
        "media-src": "'self' data: blob:",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "obr للحلول الرقمية",
    "homepage": "https://obr.obr432.workers.dev/",
    "resources": ["resources/maps/*", "resources/demo/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/installer-hooks.nsh",
        "displayLanguageSelector": false,
        "languages": ["Arabic", "English"]
      }
    }
  }
}
